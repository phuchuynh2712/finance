    "fg3": "#8A8073",
    "primary": "#1A72E0",
    "primaryHover": "#1260C0",
    "primaryPress": "#0C4D9A",
    "primarySoft": "#EDF4FF",
    "primarySoftBorder": "#A4CFFF",
    "accentRed": "#C43020",
    "gold": "#C9971F",
    "success": "#237A50",
    "successSoft": "#EBF5F0",
    "successSoftBorder": "#CCE9DA",
    "danger": "#A42619",
    "dangerSoft": "#FBEDEB",
    "dangerSoftBorder": "#F5D4CF",
    "warning": "#AE8015",
    "warningSoft": "#FBF3E0",
    "warningSoftBorder": "#F6E5BC",
    "shadowTint": "rgba(26,23,20,0.08)"
  },
  "dark": {
    "bgApp": "#1A1714",
    "bgSurface": "#241F1A",
    "bgSunken": "#332F29",
