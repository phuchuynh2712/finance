{
  "meta": {
    "app": "Kiểm Soát — Quản lý tài chính cá nhân",
    "basedOn": "Kiểm Soát Design System",
    "fontImports": [
      "https://fonts.googleapis.com/css2?family=Lexend:wght@300;400;500;600;700;800&display=swap",
      "https://fonts.googleapis.com/css2?family=Crimson+Pro:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&display=swap"
    ],
    "note": "fontSans (Lexend) = UI/body text. fontSerif (Crimson Pro) = large display/marketing headings only."
  },
  "typography": {
    "fontSans": "Lexend",
    "fontSerif": "Crimson Pro",
    "fontMono": "Cascadia Code",
    "baseSizePx": 18,
    "scalePx": { "xs": 13, "sm": 15, "base": 18, "lg": 20, "xl": 24, "2xl": 30, "3xl": 38, "4xl": 48, "5xl": 60 },
    "weight": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700, "extra": 800 },
    "lineHeight": { "tight": 1.2, "snug": 1.35, "normal": 1.6 }
  },
  "spacingPx": [4, 8, 12, 16, 20, 24, 32, 40, 48, 64, 80],
  "radiusPx": { "sm": 2, "md": 4, "lg": 6, "xl": 9, "2xl": 12, "full": 999 },
  "touchTargetMinPx": 44,
  "motion": {
    "durationMs": { "fast": 120, "base": 200, "slow": 320 },
    "easeOut": "cubic-bezier(0.22,1,0.36,1)",
    "easeInOut": "cubic-bezier(0.65,0,0.35,1)"
  },
  "light": {
