# Public runtime values for the Flutter app. Never put database passwords or
# service-role keys here. The canonical example is tool/env.example.json (see
# README.md); this dotenv copy lists the same keys, and
# test/unit/core/config/app_environment_keys_test.dart keeps them in sync.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
WEB_PASSWORD_RESET_REDIRECT_URL=http://localhost:5000/reset-callback
